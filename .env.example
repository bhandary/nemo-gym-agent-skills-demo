# Copy this file to .env and fill in a key. Do not commit .env.
# An empty POLICY_API_KEY makes ./run_demo.sh use the deterministic mock (no network model call).
# The briefing page has no mode control. Run starts a live model and never asks for a key.
# POST /api/runs still accepts mode=recorded and mode=mock.
# DEMO_SHOW_RECORDED=1 shows the saved sample on the page. Run still starts live.
# DEMO_SHOW_MOCK=1 makes Run start the local mock. Neither flag adds a mode control.
# DEMO_SHOW_MOCK=
# DEMO_SHOW_RECORDED=
# POLICY_MODEL is accepted as an alias of POLICY_MODEL_NAME.

# Chat-completions endpoint. NeMo Gym's vllm_model adapter translates the
# Responses API to POST {POLICY_BASE_URL}/chat/completions.
# NVIDIA API Catalog (build.nvidia.com / integrate.api.nvidia.com):
POLICY_BASE_URL=https://integrate.api.nvidia.com/v1
POLICY_API_KEY=
POLICY_MODEL_NAME=meta/llama-3.1-8b-instruct
POLICY_MODEL_TYPE=vllm_model

# OpenAI Responses API. Uncomment these instead of the block above.
# Live mode on the briefing page turns on when POLICY_API_KEY is a real key
# and these three are set. gpt-4.1-mini is the desk's live model.
# POLICY_BASE_URL=https://api.openai.com/v1
# POLICY_API_KEY=
# POLICY_MODEL_NAME=gpt-4.1-mini
# POLICY_MODEL_TYPE=openai_model

# Set to true only for a reasoning model served through vllm_model.
# POLICY_REASONING_PARSER=false

# Some endpoints reject temperature 0. Raise it if the live call returns that error.
# DEMO_TEMPERATURE=0
